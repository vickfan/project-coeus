# vars
COEUS_USERNAME=
COEUS_NOTES_REPO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Set to PROD on VPS to push captures to coeus-notes; omit or any other value for local-only saves
# NODE_ENV=PROD

# secrets
COEUS_NOTES_TOKEN=

# LLM metadata (weave title/tags) — Cloudflare Workers AI
# LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-3b-instruct

# Embeddings (Transformers.js — local and GitHub Actions; not Cloudflare)
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# encryption (optional — off for v1 plaintext)
# ENCRYPTION_ENABLED=true
# ENCRYPTION_KEY=
